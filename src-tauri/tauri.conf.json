{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wuwa Tappo",
  "version": "1.0.3",
  "identifier": "io.github.kyrie25.wuwatappo.cn.mac",
  "build": {
    "frontendDist": "../build/frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["desktop"],
      "csp": null
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true, "endpoints": ["https://api.github.com/repos/kyrie25/wuwa-tappo-mac/releases?per_page=100"] }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../node_modules/markdown-it/LICENSE": "licenses/markdown-it-LICENSE",
      "../node_modules/argparse/LICENSE": "licenses/argparse-LICENSE",
      "../node_modules/entities/LICENSE": "licenses/entities-LICENSE",
      "../node_modules/linkify-it/LICENSE": "licenses/linkify-it-LICENSE",
      "../node_modules/mdurl/LICENSE": "licenses/mdurl-LICENSE",
      "../node_modules/punycode.js/LICENSE-MIT.txt": "licenses/punycode-LICENSE",
      "../node_modules/uc.micro/LICENSE.txt": "licenses/uc-micro-LICENSE"
    },
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
